+/// The theme whose window is currently on screen, if any.
+///
+/// There is one window per theme but only a single global `is_visible` flag,
+/// and `with_window` resolves by the *requested* theme, so the close path has
+/// no way to tell which window it is actually closing. This lets it ask.
+pub fn visible_theme() -> Option<String> {
+    WINDOWS.with(|windows| {
+        windows
+            .get()
+            .unwrap()
+            .iter()
+            .find(|(_, w)| w.window.is_visible())
+            .map(|(k, _)| k.clone())
+    })
+}
