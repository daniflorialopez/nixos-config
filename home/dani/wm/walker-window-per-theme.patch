 fn handle_command_line(app: &Application, cmd: &ApplicationCommandLine) -> i32 {
     let options = cmd.options_dict();
 
+    // A picker from a different theme may still be on screen. walker keeps one
+    // window per theme but a single global visibility flag, and `with_window`
+    // resolves by the *requested* theme, so the close-when-open path in
+    // `activate` would hide the incoming theme's window - one that was never
+    // visible - and leave the open one orphaned on screen, where it then gets
+    // restyled, the GTK CSS provider being global to the display.
+    //
+    // Close it here rather than in `activate`, and crucially *before* this
+    // invocation's options are stored below: `quit` clears provider, nosearch,
+    // nohints and the geometry overrides, which has to happen to the state of
+    // the invocation that is ending, not to the one we are about to open.
+    if let Some(visible) = visible_theme() {
+        let requested = options
+            .lookup_value("theme", Some(VariantTy::STRING))
+            .and_then(|v| v.str().map(str::to_string))
+            .filter(|t| has_theme(t))
+            .unwrap_or_else(get_theme);
+
+        if visible != requested {
+            set_theme(visible);
+            quit(app, false);
+        }
+    }
+
