{
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(hyprctl monitors:*)",
      "Bash(hyprctl clients:*)",
      "Bash(gamemoded -s)",
      "Bash(nvidia-smi:*)",
      "Bash(powerprofilesctl get)",
      "Bash(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)",
      "Bash(cat /sys/firmware/acpi/platform_profile)",
      "Bash(cat /sys/firmware/acpi/platform_profile_choices)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(nixos-rebuild:*)",
      "Bash(nh:*)"
    ]
  }
}
